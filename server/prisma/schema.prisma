generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("user") // "admin" | "user"
  created_at    DateTime @default(now())

  companies     Company[]
}

model Company {
  id              String   @id @default(uuid())
  name            String
  logo_url        String?
  primary_color   String?
  secondary_color String?
  menu_style      Json?    // { heading: { font, size, weight }, body: { font, size, weight } }
  icons           Json?    // [{ id, name, mime, data_url, position: { h, v } }]
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])

  wines              Wine[]
  exportTemplates    WineExportTemplate[]
  posIntegrations    POSIntegration[]
}

model POSIntegration {
  id             String    @id @default(uuid())
  company_id     String
  company        Company   @relation(fields: [company_id], references: [id])
  provider       String    // "lightspeed" | "untill" | "square" | "other"
  display_name   String
  api_key_enc    String
  api_secret_enc String?
  location_id    String?
  config         Json?     // provider-specific velden (host, port, database, username, ...)
  is_active      Boolean   @default(true)
  last_synced_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  catalog_items  POSCatalogItem[]
  mappings       POSProductMapping[]
}

model POSCatalogItem {
  id             String          @id @default(uuid())
  integration_id String
  integration    POSIntegration  @relation(fields: [integration_id], references: [id], onDelete: Cascade)
  external_id    String
  name           String
  category       String?
  price          Float?
  last_seen_at   DateTime        @default(now())

  @@unique([integration_id, external_id])
  @@index([integration_id, name])
}

model POSProductMapping {
  id             String          @id @default(uuid())
  integration_id String
  integration    POSIntegration  @relation(fields: [integration_id], references: [id], onDelete: Cascade)
  wine_id        String
  wine           Wine            @relation(fields: [wine_id], references: [id], onDelete: Cascade)
  external_id    String
  external_name  String
  unit           String          @default("bottle") // "bottle" | "glass" | "half_bottle"
  units_per_sale Float           @default(1)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  @@unique([integration_id, external_id, unit])
  @@index([wine_id])
}

model WineExportTemplate {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id])
  name        String
  title       String   @default("Wijnkaart")
  structure   Json     // { groups: [ { id, name, rules, sort, children } ] }
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Wine {
  id               String      @id @default(uuid())
  catalog_id       String
  catalog          WineCatalog @relation(fields: [catalog_id], references: [id])
  company_id       String
  company          Company     @relation(fields: [company_id], references: [id])
  vintage          Int?
  supplier         String?
  purchase_price   Float       @default(0)
  sell_price       Float?
  sell_price_glass Float?
  stock_count      Int         @default(0)
  min_stock_alert  Int         @default(0)
  days_in_stock    Int         @default(0)
  created_at       DateTime    @default(now())

  stock_movements  StockMovement[]
  pos_mappings     POSProductMapping[]
}

model StockMovement {
  id          String   @id @default(uuid())
  wine_id     String
  wine        Wine     @relation(fields: [wine_id], references: [id])
  type        String   // purchase/sale/adjustment
  quantity    Int
  note        String?
  created_at  DateTime @default(now())
}

model WineCatalog {
  id               String   @id @default(uuid())
  name             String   @unique
  region           String
  subregion        String?
  country          String
  vintage          Int?
  grape            String?
  type             String
  bottle_size      String?
  image_url        String?

  // Detailed information
  elaborate        String?
  harmonize        String?
  abv              Float?
  body             String?
  acidity          String?
  winery           String?
  website          String?

  is_verified      Boolean  @default(true)
  created_at       DateTime @default(now())

  wines            Wine[]
}
